# AgentLens Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# ==============================================================================
# Database Configuration (PostgreSQL 16)
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentlens
POSTGRES_USER=agentlens
POSTGRES_PASSWORD=agentlens_secure_password_replace_in_prod

# Complete Async SQLAlchemy Database URL (Optional override)
# DATABASE_URL=postgresql+asyncpg://agentlens:agentlens_secure_password_replace_in_prod@localhost:5432/agentlens

# ==============================================================================
# Database Connection Pool Settings
# ==============================================================================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ==============================================================================
# Application Settings
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
